{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "skipLibCheck": true,
    "noEmit": true, "jsx": "react-jsx", "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["client/App.tsx", "client/OptionalAnalytics.tsx", "client/pages/Index.tsx", "client/lib/utils.ts", "client/lib/utils.spec.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
